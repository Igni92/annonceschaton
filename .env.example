# Variables d'environnement reconnues (facultatives — équivalentes aux clés de config.json).
# Chargez-les avec `export $(grep -v '^#' .env | xargs)` ou via votre gestionnaire de secrets.

# Notifications (leur présence active automatiquement le canal)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zone (surchargent config.json)
# ANNONCES_ZONE_MODE=rayon            # rayon | departements | france
# ANNONCES_VILLE=Lyon
# ANNONCES_CODE_POSTAL=69001
# ANNONCES_LATITUDE=45.764
# ANNONCES_LONGITUDE=4.836
# ANNONCES_RAYON_KM=40
# ANNONCES_DEPARTEMENTS=69,01,38

# Critères
# ANNONCES_AGE_MAX_MOIS=4
# ANNONCES_NOUVEAUX_JOURS=7

# Fichiers
# ANNONCES_STATE_FILE=data/state.json
# ANNONCES_REPORTS_DIR=reports
